# Twitter API Credentials
export TWITTER_BEARER_TOKEN=your-bearer-token-here
export TWITTER_API_KEY=your-api-key-here
export TWITTER_API_SECRET=your-api-secret-here
export TWITTER_ACCESS_TOKEN=your-access-token-here
export TWITTER_ACCESS_SECRET=your-access-secret-here

# Bot Configuration
export BOT_USER_ID=your-bot-twitter-user-id
export ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Anthropic Model Configuration (optional, defaults to claude-sonnet-4-20250514)
export ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Prompt File (optional, defaults to prompt.txt)
export PROMPT_FILE=src/prompt.txt

# Optional Configuration
export DB_PATH=live/norma_bot.db
export MAX_MENTIONS_PER_RUN=10
export API_TIMEOUT_SECONDS=30

# API Endpoint Configuration (optional, for testing with mock server)
# Uncomment and set these to use a local test server instead of real APIs
# export TWITTER_API_BASE=http://127.0.0.1:8080
# export ANTHROPIC_API_BASE=http://127.0.0.1:8080
